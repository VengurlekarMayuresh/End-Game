# Environment Variables
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=supersecretjwtkey

# Supabase PostgreSQL Connection
# Replace with your actual Supabase Transaction connection string
DATABASE_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Replace with your actual Supabase Session connection string for migrations
DIRECT_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
