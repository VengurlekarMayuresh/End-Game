// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id                 String    @id @default(uuid())
  googleId           String?   @unique
  fullName           String
  email              String    @unique
  profilePicture     String?
  role               Role?
  status             UserStatus @default(PENDING)
  isProfileCompleted Boolean   @default(false)
  lastLogin          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile     Student?
  recruiterProfile   Recruiter?
}

// -----------------------------------------
// STUDENT MODULE MODELS
// -----------------------------------------

model Student {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Info
  phone          String?
  gender         String?
  dob            DateTime?
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?

  // Relations
  education      StudentEducation[]
  skills         StudentSkill[]
  projects       StudentProject[]
  certifications StudentCertification[]
  experiences    StudentExperience[]
  languages      StudentLanguage[]
  documents      StudentDocument[]
  socialLinks    StudentSocial?
  preferences    StudentPreference?
  applications   JobApplication[]
  testAttempts   TestAttempt[]
  codingAttempts CodingAttempt[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentEducation {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution    String
  university     String?
  degree         String
  branch         String
  cgpa           Float?
  percentage     Float?
  startYear      Int
  endYear        Int?
  isCurrent      Boolean  @default(false)
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model StudentSkill {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  category       String?
  level          SkillLevel @default(INTERMEDIATE)
}

model StudentProject {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  description    String   @db.Text
  techStack      String[]
  role           String?
  duration       String?
  githubUrl      String?
  liveUrl        String?
}

model StudentCertification {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  organization   String
  issueDate      DateTime
  expiryDate     DateTime?
  credentialId   String?
  credentialUrl  String?
}

model StudentExperience {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company        String
  role           String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean  @default(false)
  description    String?  @db.Text
}

enum Proficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model StudentLanguage {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  language       String
  read           Boolean  @default(true)
  write          Boolean  @default(true)
  speak          Boolean  @default(true)
  proficiency    Proficiency @default(FLUENT)
}

enum DocumentType {
  RESUME
  PICTURE
  CERTIFICATE
  OTHER
}

model StudentDocument {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           DocumentType
  url            String
  filename       String
  size           Int?         // in bytes
  mimetype       String?
  createdAt      DateTime     @default(now())
}

model StudentSocial {
  id             String   @id @default(uuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  github         String?
  linkedin       String?
  portfolio      String?
  leetcode       String?
  codechef       String?
  hackerrank     String?
  codeforces     String?
}

model StudentPreference {
  id               String   @id @default(uuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  preferredRoles   String[]
  preferredLocations String[]
  expectedSalary   String?
  employmentType   String?
  remotePreference String?
}


// -----------------------------------------
// RECRUITER / ADMIN MODELS (From Module 1)
// -----------------------------------------

model Recruiter {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String?
  designation        String?
  industry           String?
  companyWebsite     String?
  companySize        String?
  companyDescription String?
  phone              String?
  companyLogo        String?
  officeAddress      String?
  jobs               Job[]
  questions          Question[]
  tests              Test[]
  codingAssessments  CodingAssessment[]
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// JOB PORTAL MODELS
// -----------------------------------------

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
}

model Job {
  id               String      @id @default(uuid())
  recruiterId      String
  recruiter        Recruiter   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  title            String
  description      String      @db.Text
  requirements     String?     @db.Text
  responsibilities String?     @db.Text
  location         String
  isRemote         Boolean     @default(false)
  employmentType   String
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String      @default("INR")
  skills           String[]
  experienceMin    Int         @default(0)
  experienceMax    Int?
  openings         Int         @default(1)
  status           JobStatus   @default(ACTIVE)
  deadline         DateTime?

  applications     JobApplication[]
  testId           String?
  test             Test?       @relation(fields: [testId], references: [id], onDelete: SetNull)
  codingAssessmentId String?
  codingAssessment   CodingAssessment? @relation(fields: [codingAssessmentId], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model JobApplication {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status      ApplicationStatus @default(APPLIED)
  coverLetter String?           @db.Text
  resumeUrl   String?
  notes       String?           @db.Text   // Recruiter private notes

  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, studentId])
}

// -----------------------------------------
// APTITUDE TEST MODULE MODELS
// -----------------------------------------

model Question {
  id            String         @id @default(uuid())
  recruiterId   String
  recruiter     Recruiter      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  statement     String         @db.Text
  options       String[]
  correctAnswer String
  explanation   String?        @db.Text
  category      String
  topic         String?
  difficulty    String         // EASY, MEDIUM, HARD
  tags          String[]
  marks         Float          @default(1.0)
  negativeMarks Float          @default(0.0)
  estimatedTime Int?           // in seconds
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  testQuestions TestQuestion[]
}

model Test {
  id                  String         @id @default(uuid())
  recruiterId         String
  recruiter           Recruiter      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name                String
  description         String?        @db.Text
  instructions        String?        @db.Text
  duration            Int            // in minutes
  passingPercentage   Float          @default(40.0)
  maxAttempts         Int            @default(1)
  negativeMarking     Boolean        @default(false)
  marksPerQuestion    Float          @default(1.0)
  randomQuestionOrder Boolean        @default(false)
  randomOptionOrder   Boolean        @default(false)
  numQuestions        Int?
  startDate           DateTime?
  endDate             DateTime?
  status              String         @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  jobs                Job[]
  testQuestions       TestQuestion[]
  attempts            TestAttempt[]
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([testId, questionId])
}

model TestAttempt {
  id                  String    @id @default(uuid())
  testId              String
  test                Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score               Float     @default(0.0)
  percentage          Float     @default(0.0)
  passed              Boolean   @default(false)
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  timeTaken           Int?      // in seconds
  status              String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, AUTO_SUBMITTED
  correctAnswersCount Int       @default(0)
  wrongAnswersCount   Int       @default(0)
  skippedCount        Int       @default(0)
  answers             Json      // array of answer objects: e.g. [{questionId, selectedOption, isCorrect, score}]
  categoryBreakdown   Json?     // category-wise performance
  difficultyBreakdown Json?     // difficulty-wise performance
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// -----------------------------------------
// CODING ASSESSMENT MODULE MODELS
// -----------------------------------------

model CodingAssessment {
  id                String          @id @default(uuid())
  recruiterId       String
  recruiter         Recruiter       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name              String
  description       String?         @db.Text
  instructions      String?         @db.Text
  duration          Int             // in minutes
  status            String          @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  problems          CodingProblem[]
  jobs              Job[]
  attempts          CodingAttempt[]
}

model CodingProblem {
  id                 String             @id @default(uuid())
  codingAssessmentId String
  codingAssessment   CodingAssessment   @relation(fields: [codingAssessmentId], references: [id], onDelete: Cascade)
  title              String
  statement          String             @db.Text
  description        String             @db.Text
  difficulty         String             // EASY, MEDIUM, HARD
  inputFormat        String             @db.Text
  outputFormat       String             @db.Text
  constraints        String             @db.Text
  examples           Json               // [{input, output, explanation}]
  sampleInput        String             @db.Text
  sampleOutput       String             @db.Text
  marks              Float              @default(10.0)
  supportedLanguages String[]           // e.g. ["PYTHON", "JAVA"]
  pythonStarterCode  String?            @db.Text
  javaStarterCode    String?            @db.Text
  order              Int                @default(0)
  status             String             @default("ACTIVE") // ACTIVE, INACTIVE
  testCases          CodingTestCase[]
  submissions        CodingSubmission[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CodingTestCase {
  id              String        @id @default(uuid())
  codingProblemId String
  codingProblem   CodingProblem @relation(fields: [codingProblemId], references: [id], onDelete: Cascade)
  input           String        @db.Text
  expectedOutput  String        @db.Text
  isPublic        Boolean       @default(false)
  marks           Float         @default(1.0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CodingAttempt {
  id                 String             @id @default(uuid())
  codingAssessmentId String
  codingAssessment   CodingAssessment   @relation(fields: [codingAssessmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score              Float              @default(0.0)
  passed             Boolean            @default(false)
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  timeTaken          Int?               // in seconds
  status             String             @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, AUTO_SUBMITTED
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  submissions        CodingSubmission[]
}

model CodingSubmission {
  id              String        @id @default(uuid())
  codingAttemptId String
  codingAttempt   CodingAttempt @relation(fields: [codingAttemptId], references: [id], onDelete: Cascade)
  codingProblemId String
  codingProblem   CodingProblem @relation(fields: [codingProblemId], references: [id], onDelete: Cascade)
  language        String        // PYTHON, JAVA
  code            String        @db.Text
  marksObtained   Float         @default(0.0)
  testsPassed     Int           @default(0)
  totalTests      Int           @default(0)
  status          String        @default("PENDING") // PENDING, COMPILED, COMPILATION_FAILED, RUNTIME_ERROR, TIME_LIMIT_EXCEEDED, SUCCESS
  executionTime   Float?        // in seconds
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CodingAutosave {
  id              String   @id @default(uuid())
  studentId       String
  codingProblemId String
  language        String
  code            String   @db.Text
  updatedAt       DateTime @updatedAt

  @@unique([studentId, codingProblemId])
}

