// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id                 String    @id @default(uuid())
  googleId           String?   @unique
  fullName           String
  email              String    @unique
  profilePicture     String?
  role               Role?
  status             UserStatus @default(PENDING)
  isProfileCompleted Boolean   @default(false)
  lastLogin          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile     Student?
  recruiterProfile   Recruiter?
}

// -----------------------------------------
// STUDENT MODULE MODELS
// -----------------------------------------

model Student {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Info
  phone          String?
  gender         String?
  dob            DateTime?
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?

  // Relations
  education      StudentEducation[]
  skills         StudentSkill[]
  projects       StudentProject[]
  certifications StudentCertification[]
  experiences    StudentExperience[]
  languages      StudentLanguage[]
  documents      StudentDocument[]
  socialLinks    StudentSocial?
  preferences    StudentPreference?
  applications   JobApplication[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentEducation {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution    String
  university     String?
  degree         String
  branch         String
  cgpa           Float?
  percentage     Float?
  startYear      Int
  endYear        Int?
  isCurrent      Boolean  @default(false)
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model StudentSkill {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  category       String?
  level          SkillLevel @default(INTERMEDIATE)
}

model StudentProject {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  description    String   @db.Text
  techStack      String[]
  role           String?
  duration       String?
  githubUrl      String?
  liveUrl        String?
}

model StudentCertification {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  organization   String
  issueDate      DateTime
  expiryDate     DateTime?
  credentialId   String?
  credentialUrl  String?
}

model StudentExperience {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company        String
  role           String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean  @default(false)
  description    String?  @db.Text
}

enum Proficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model StudentLanguage {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  language       String
  read           Boolean  @default(true)
  write          Boolean  @default(true)
  speak          Boolean  @default(true)
  proficiency    Proficiency @default(FLUENT)
}

enum DocumentType {
  RESUME
  PICTURE
  CERTIFICATE
  OTHER
}

model StudentDocument {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           DocumentType
  url            String
  filename       String
  size           Int?         // in bytes
  mimetype       String?
  createdAt      DateTime     @default(now())
}

model StudentSocial {
  id             String   @id @default(uuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  github         String?
  linkedin       String?
  portfolio      String?
  leetcode       String?
  codechef       String?
  hackerrank     String?
  codeforces     String?
}

model StudentPreference {
  id               String   @id @default(uuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  preferredRoles   String[]
  preferredLocations String[]
  expectedSalary   String?
  employmentType   String?
  remotePreference String?
}


// -----------------------------------------
// RECRUITER / ADMIN MODELS (From Module 1)
// -----------------------------------------

model Recruiter {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String?
  designation        String?
  industry           String?
  companyWebsite     String?
  companySize        String?
  companyDescription String?
  phone              String?
  companyLogo        String?
  officeAddress      String?
  jobs               Job[]
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// JOB PORTAL MODELS
// -----------------------------------------

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
}

model Job {
  id               String      @id @default(uuid())
  recruiterId      String
  recruiter        Recruiter   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  title            String
  description      String      @db.Text
  requirements     String?     @db.Text
  responsibilities String?     @db.Text
  location         String
  isRemote         Boolean     @default(false)
  employmentType   String
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String      @default("INR")
  skills           String[]
  experienceMin    Int         @default(0)
  experienceMax    Int?
  openings         Int         @default(1)
  status           JobStatus   @default(ACTIVE)
  deadline         DateTime?

  applications     JobApplication[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model JobApplication {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status      ApplicationStatus @default(APPLIED)
  coverLetter String?           @db.Text
  resumeUrl   String?
  notes       String?           @db.Text   // Recruiter private notes

  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, studentId])
}
